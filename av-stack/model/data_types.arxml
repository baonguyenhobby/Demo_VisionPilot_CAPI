<?xml version="1.0" encoding="UTF-8"?>
<!--
  VisionPilot on AUTOSAR Adaptive (CAPI) — implementation data types.

  One structure per service interface, matching the four-AA decomposition
  (Sensing / Perception / Planning / Control). Every field is fixed-width and
  every field order is explicit, because the SOME/IP serialiser lays them out in
  declaration order and a reordering is a silent wire-format break.

  Sizing (SOME/IP payload, no alignment padding assumed):
    FrameDescriptor   8+4+4+2+2+4+2+2+4+1+1        = 34 B
    DrivingState      8+4+4*6+1+1+4+4+1            = 47 B
    Trajectory        8+4+4+(20*4)+1               = 97 B
    VehicleSpeed      8+4+4+1                      = 17 B

  Every type here is BOUNDED — no vector, no string, no variable-size element.
  All four events therefore fit in one UDP datagram inside a single Ethernet
  MTU, with no IP fragmentation and no SOME/IP-TP segmentation to reason about.

  That stays true even though Sensing is now a separate Adaptive Application
  publishing camera frames, because the frame PAYLOAD does not travel through
  ara::com. Sensing writes each frame into a shared-memory ring and publishes
  only the descriptor below. See service_interfaces.arxml for the full rationale
  and for what that costs.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>AvTypes</SHORT-NAME>
      <AR-PACKAGES>
        <AR-PACKAGE>
          <SHORT-NAME>DataTypes</SHORT-NAME>
          <ELEMENTS>

            <!-- ============================================================
                 Sensing -> Perception

                 A reference to a frame, not the frame. The two images produced
                 by one capture (BEV-warped and plain-resized) travel in ONE
                 descriptor with ONE timestamp: they come from the same camera
                 exposure and are only meaningful together, so splitting them
                 would put a tearing hazard on the boundary that Perception
                 would have to re-detect.

                 Reader protocol (seqlock):
                   1. read descriptor, note generation G
                   2. consume warpedSlot / resizedSlot from the mapped segment
                   3. re-read the slot header's generation; if it is no longer
                      G, the writer lapped you — discard the frame
                 The producer never blocks on a slow consumer, which is the
                 behaviour a perception pipeline wants.

                 segmentInstanceId must change every time Sensing creates the
                 segment. Without it, a restarted sensingd hands Perception a
                 recreated segment that looks exactly like the old one — the
                 failure mode that costs people days.
                 ============================================================ -->
            <STD-CPP-IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>FrameDescriptor</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Reference to one camera capture held in the shared-memory ring. Carries no pixel data.</L-2>
              </DESC>
              <CATEGORY>STRUCTURE</CATEGORY>
              <NAMESPACES>
                <SYMBOL-PROPS><SHORT-NAME>av</SHORT-NAME><SYMBOL>av</SYMBOL></SYMBOL-PROPS>
                <SYMBOL-PROPS><SHORT-NAME>vp</SHORT-NAME><SYMBOL>vp</SYMBOL></SYMBOL-PROPS>
                <SYMBOL-PROPS><SHORT-NAME>cm</SHORT-NAME><SYMBOL>cm</SYMBOL></SYMBOL-PROPS>
              </NAMESPACES>
              <SUB-ELEMENTS>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>timestampNs</SHORT-NAME>
                  <DESC><L-2 L="EN">Capture time, not publish time. Everything downstream ages the frame from here.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint64_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>seqCounter</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>segmentInstanceId</SHORT-NAME>
                  <DESC><L-2 L="EN">New value each time Sensing creates the shared segment. A consumer holding a different value must re-map before reading.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>warpedSlot</SHORT-NAME>
                  <DESC><L-2 L="EN">Ring index of the BEV-warped image.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint16_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>resizedSlot</SHORT-NAME>
                  <DESC><L-2 L="EN">Ring index of the plain-resized image.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint16_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>generation</SHORT-NAME>
                  <DESC><L-2 L="EN">Seqlock counter. Re-read the slot header after consuming; a changed value means the writer lapped the reader and the frame must be discarded.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>width</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint16_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>height</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint16_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>stride</SHORT-NAME>
                  <DESC><L-2 L="EN">Row stride in bytes. Explicit because a DMA-buf allocation on the Orin is not guaranteed to be tightly packed.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>pixelFormat</SHORT-NAME>
                  <DESC><L-2 L="EN">0 = BGR8 (OpenCV native). Reserved for the OAK-D and for NV12 capture paths.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint8_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>valid</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint8_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
              <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
            </STD-CPP-IMPLEMENTATION-DATA-TYPE>

            <!-- ============================================================
                 Perception -> Planning

                 Exactly the arguments Planner::compute_plan takes, minus ego
                 speed (which Control senses and publishes separately), plus the
                 fields Visualization needs. Nothing here is a generic object
                 list: VisionPilot does not produce one, and modelling one would
                 be inventing an interface no code fills.
                 ============================================================ -->
            <STD-CPP-IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>DrivingState</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Fused lane-relative state and CIPO estimate from one perception cycle.</L-2>
              </DESC>
              <CATEGORY>STRUCTURE</CATEGORY>
              <NAMESPACES>
                <SYMBOL-PROPS><SHORT-NAME>av</SHORT-NAME><SYMBOL>av</SYMBOL></SYMBOL-PROPS>
                <SYMBOL-PROPS><SHORT-NAME>vp</SHORT-NAME><SYMBOL>vp</SYMBOL></SYMBOL-PROPS>
                <SYMBOL-PROPS><SHORT-NAME>cm</SHORT-NAME><SYMBOL>cm</SYMBOL></SYMBOL-PROPS>
              </NAMESPACES>
              <SUB-ELEMENTS>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>timestampNs</SHORT-NAME>
                  <DESC><L-2 L="EN">Copied from the FrameDescriptor that produced it, so age is measured from capture and not from perception's own publish.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint64_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>seqCounter</SHORT-NAME>
                  <DESC><L-2 L="EN">Planning's staleness check keys on this: an unchanged counter is a stalled producer even when the timestamp still looks fresh.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>cteM</SHORT-NAME>
                  <DESC><L-2 L="EN">Cross-track error, m (LateralFusionEstimate.cte_m).</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>epsiRad</SHORT-NAME>
                  <DESC><L-2 L="EN">Heading error, rad (yaw_rad).</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>kappa</SHORT-NAME>
                  <DESC><L-2 L="EN">Road curvature, 1/m.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>cteRateMps</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>yawRateRps</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>rawCteM</SHORT-NAME>
                  <DESC><L-2 L="EN">Unfiltered cross-track error, for logging and the visualization overlay only. Never an input to planning.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>pathValid</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint8_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>hasCipo</SHORT-NAME>
                  <DESC><L-2 L="EN">Tracker-based: true only when the filter tracks a target closer than D_MAX. cipo_raw_found alone must not gate the planner.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint8_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>cipoDistanceM</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>cipoVelocityMps</SHORT-NAME>
                  <DESC><L-2 L="EN">Negative = approaching. When hasCipo is 0 the planner substitutes the configured speed limit; this field is then meaningless, not zero.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>valid</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint8_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
              <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
            </STD-CPP-IMPLEMENTATION-DATA-TYPE>

            <!-- ============================================================
                 Planning -> Control

                 The whole 20-step steering horizon, not just the applied value.
                 N = 20 is fixed in lateral_planning.cpp, so the type stays
                 bounded.

                 Publishing the horizon is what makes Degraded a real state
                 rather than an immediate stop: when planningd is stopped,
                 Control still holds a trajectory it can follow — with rate
                 limiting and decay — for the remaining horizon before the
                 staleness gate commands a safe stop. Publishing only
                 steering[1] would make the vehicle drop actuation the instant
                 planning goes away.

                 ARA-GEN RISK: this is the one construct in the model not
                 checked against a CAPI example. If the array type does not
                 generate, the fallback is a single steeringRad field and
                 losing the graceful-degradation property above — a design
                 downgrade, not just a schema edit.
                 ============================================================ -->
            <STD-CPP-IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>SteeringHorizon</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Fixed 20-step tyre-angle sequence in radians. N matches LateralPlanner's horizon.</L-2>
              </DESC>
              <CATEGORY>ARRAY</CATEGORY>
              <ARRAY-SIZE>20</ARRAY-SIZE>
              <NAMESPACES>
                <SYMBOL-PROPS><SHORT-NAME>av</SHORT-NAME><SYMBOL>av</SYMBOL></SYMBOL-PROPS>
                <SYMBOL-PROPS><SHORT-NAME>vp</SHORT-NAME><SYMBOL>vp</SYMBOL></SYMBOL-PROPS>
                <SYMBOL-PROPS><SHORT-NAME>cm</SHORT-NAME><SYMBOL>cm</SYMBOL></SYMBOL-PROPS>
              </NAMESPACES>
              <TEMPLATE-ARGUMENTS>
                <CPP-TEMPLATE-ARGUMENT>
                  <TEMPLATE-TYPE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TEMPLATE-TYPE-REF>
                </CPP-TEMPLATE-ARGUMENT>
              </TEMPLATE-ARGUMENTS>
              <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
            </STD-CPP-IMPLEMENTATION-DATA-TYPE>

            <STD-CPP-IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>Trajectory</SHORT-NAME>
              <DESC>
                <L-2 L="EN">One planning cycle: longitudinal acceleration, the steering horizon, and the worst active warning.</L-2>
              </DESC>
              <CATEGORY>STRUCTURE</CATEGORY>
              <NAMESPACES>
                <SYMBOL-PROPS><SHORT-NAME>av</SHORT-NAME><SYMBOL>av</SYMBOL></SYMBOL-PROPS>
                <SYMBOL-PROPS><SHORT-NAME>vp</SHORT-NAME><SYMBOL>vp</SYMBOL></SYMBOL-PROPS>
                <SYMBOL-PROPS><SHORT-NAME>cm</SHORT-NAME><SYMBOL>cm</SYMBOL></SYMBOL-PROPS>
              </NAMESPACES>
              <SUB-ELEMENTS>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>timestampNs</SHORT-NAME>
                  <DESC><L-2 L="EN">Propagated from the DrivingState that produced it, and thence from capture.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint64_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>seqCounter</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>accelerationMps2</SHORT-NAME>
                  <DESC><L-2 L="EN">Longitudinal acceleration request, m/s^2 (Plan.acceleration).</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>steeringHorizonRad</SHORT-NAME>
                  <DESC><L-2 L="EN">Plan.steering. Control applies index 1, as upstream main() does; the remainder is what it follows if planning stops.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AvTypes/DataTypes/SteeringHorizon</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>warning</SHORT-NAME>
                  <DESC><L-2 L="EN">0 None, 1 FCW, 2 AEB, 3 LLDW, 4 RLDW. Plan.warnings is a list; the most severe one wins, and severity is not numeric order — a brake demand must never be masked by the warning that preceded it.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint8_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
              <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
            </STD-CPP-IMPLEMENTATION-DATA-TYPE>

            <!-- ============================================================
                 Control -> Planning

                 Ego speed. Control senses it (from /odom or the ESP32 frame)
                 because Control owns the chassis link, and publishes it because
                 Planning needs it as compute_plan's ego_v argument.

                 valid = 0 means the producer does not stand behind the value;
                 the consumer must not silently treat it as 0 m/s.
                 ============================================================ -->
            <STD-CPP-IMPLEMENTATION-DATA-TYPE>
              <SHORT-NAME>VehicleSpeed</SHORT-NAME>
              <DESC>
                <L-2 L="EN">Ego longitudinal speed with validity flag.</L-2>
              </DESC>
              <CATEGORY>STRUCTURE</CATEGORY>
              <NAMESPACES>
                <SYMBOL-PROPS><SHORT-NAME>av</SHORT-NAME><SYMBOL>av</SYMBOL></SYMBOL-PROPS>
                <SYMBOL-PROPS><SHORT-NAME>vp</SHORT-NAME><SYMBOL>vp</SYMBOL></SYMBOL-PROPS>
                <SYMBOL-PROPS><SHORT-NAME>cm</SHORT-NAME><SYMBOL>cm</SYMBOL></SYMBOL-PROPS>
              </NAMESPACES>
              <SUB-ELEMENTS>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>timestampNs</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint64_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>seqCounter</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint32_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>speedMps</SHORT-NAME>
                  <DESC><L-2 L="EN">Metres per second. float32: the planner works in double, but the sensor resolution does not justify 8 bytes on the wire.</L-2></DESC>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/float</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                <CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
                  <SHORT-NAME>valid</SHORT-NAME>
                  <TYPE-REFERENCE>
                    <TYPE-REFERENCE-REF DEST="STD-CPP-IMPLEMENTATION-DATA-TYPE">/AUTOSAR/StdTypes/uint8_t</TYPE-REFERENCE-REF>
                  </TYPE-REFERENCE>
                </CPP-IMPLEMENTATION-DATA-TYPE-ELEMENT>
              </SUB-ELEMENTS>
              <TYPE-EMITTER>TYPE_EMITTER_ARA</TYPE-EMITTER>
            </STD-CPP-IMPLEMENTATION-DATA-TYPE>

          </ELEMENTS>
        </AR-PACKAGE>
      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>

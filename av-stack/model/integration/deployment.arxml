            </PROCESS-TO-MACHINE-MAPPING>
            <PROCESS-TO-MACHINE-MAPPING>
              <SHORT-NAME>SensingMapping</SHORT-NAME>
              <MACHINE-REF DEST="MACHINE">/ISOFT/Development/Machine1</MACHINE-REF>
              <PROCESS-REF DEST="PROCESS">/AvDeployment/sensing_process</PROCESS-REF>
            </PROCESS-TO-MACHINE-MAPPING>
            <PROCESS-TO-MACHINE-MAPPING>
              <SHORT-NAME>PerceptionMapping</SHORT-NAME>
              <MACHINE-REF DEST="MACHINE">/ISOFT/Development/Machine1</MACHINE-REF>
              <PROCESS-REF DEST="PROCESS">/AvDeployment/perception_process</PROCESS-REF>
            </PROCESS-TO-MACHINE-MAPPING>
            <PROCESS-TO-MACHINE-MAPPING>

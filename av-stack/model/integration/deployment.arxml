    <!-- IAM grants. Without these the calls are refused at run time even though
         the model resolves: offering, finding and sending are each authorised
         separately. -->
    <AR-PACKAGE>
      <SHORT-NAME>AvGrants</SHORT-NAME>
      <ELEMENTS>
        <COM-OFFER-SERVICE-GRANT UUID="">
          <SHORT-NAME>offer_cameraframe</SHORT-NAME>
          <SERVICE-INSTANCE-REF DEST="PROVIDED-SOMEIP-SERVICE-INSTANCE">/AvSomeipInstances/ProvidedInstance_CameraFrame</SERVICE-INSTANCE-REF>

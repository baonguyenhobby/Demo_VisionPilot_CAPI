<?xml version="1.0" encoding="UTF-8"?>
<!--
  Machine extension — adds this project's DLT log channels to Machine1.

  The MACHINE element itself is NOT declared here. It already exists in CAPI's
  own model (isoft/arxmls/models/development_machines/machine1/common/machine.arxml)
  along with its OS resource groups and network connectors; this file only adds
  to it. That is why isoft/arxmls/models must be on the ara-gen input list, and
  why a second <MACHINE> declaration here would be a duplicate rather than an
  override.

  Context IDs: #DFT is the platform default, #COM is ara::com's own channel, and
  #VPA is the one ap_runtime, camera and vehicle backends log to
  (ara::log::CreateLogger("#VPA", ...)). Filter on #VPA in dlt-viewer to see only
  this application's messages.
-->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00049.xsd">
    <AR-PACKAGES>
        <AR-PACKAGE>
            <SHORT-NAME>ISOFT</SHORT-NAME>
            <AR-PACKAGES>
                <AR-PACKAGE>
                    <SHORT-NAME>Development</SHORT-NAME>
                    <ELEMENTS>
                        <MACHINE>
                            <SHORT-NAME>Machine1</SHORT-NAME>
                            <MODULE-INSTANTIATIONS>
                                <LOG-AND-TRACE-INSTANTIATION>
                                    <SHORT-NAME>sensing_log</SHORT-NAME>
                                    <DLT-LOG-CHANNELS>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>default</SHORT-NAME>
                                            <APPLICATION-ID>sens</APPLICATION-ID>
                                            <CONTEXT-ID>#DFT</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>com</SHORT-NAME>
                                            <APPLICATION-ID>sens</APPLICATION-ID>
                                            <CONTEXT-ID>#COM</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>vpa</SHORT-NAME>
                                            <APPLICATION-ID>sens</APPLICATION-ID>
                                            <CONTEXT-ID>#VPA</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                    </DLT-LOG-CHANNELS>
                                </LOG-AND-TRACE-INSTANTIATION>
                                <LOG-AND-TRACE-INSTANTIATION>
                                    <SHORT-NAME>perception_log</SHORT-NAME>
                                    <DLT-LOG-CHANNELS>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>default</SHORT-NAME>
                                            <APPLICATION-ID>perc</APPLICATION-ID>
                                            <CONTEXT-ID>#DFT</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>com</SHORT-NAME>
                                            <APPLICATION-ID>perc</APPLICATION-ID>
                                            <CONTEXT-ID>#COM</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>vpa</SHORT-NAME>
                                            <APPLICATION-ID>perc</APPLICATION-ID>
                                            <CONTEXT-ID>#VPA</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                    </DLT-LOG-CHANNELS>
                                </LOG-AND-TRACE-INSTANTIATION>
                                <LOG-AND-TRACE-INSTANTIATION>
                                    <SHORT-NAME>planning_log</SHORT-NAME>
                                    <DLT-LOG-CHANNELS>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>default</SHORT-NAME>
                                            <APPLICATION-ID>plan</APPLICATION-ID>
                                            <CONTEXT-ID>#DFT</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>com</SHORT-NAME>
                                            <APPLICATION-ID>plan</APPLICATION-ID>
                                            <CONTEXT-ID>#COM</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>vpa</SHORT-NAME>
                                            <APPLICATION-ID>plan</APPLICATION-ID>
                                            <CONTEXT-ID>#VPA</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                    </DLT-LOG-CHANNELS>
                                </LOG-AND-TRACE-INSTANTIATION>
                                <LOG-AND-TRACE-INSTANTIATION>
                                    <SHORT-NAME>control_log</SHORT-NAME>
                                    <DLT-LOG-CHANNELS>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>default</SHORT-NAME>
                                            <APPLICATION-ID>cont</APPLICATION-ID>
                                            <CONTEXT-ID>#DFT</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>com</SHORT-NAME>
                                            <APPLICATION-ID>cont</APPLICATION-ID>
                                            <CONTEXT-ID>#COM</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                        <DLT-LOG-CHANNEL>
                                            <SHORT-NAME>vpa</SHORT-NAME>
                                            <APPLICATION-ID>cont</APPLICATION-ID>
                                            <CONTEXT-ID>#VPA</CONTEXT-ID>
                                            <LOG-TRACE-DEFAULT-LOG-LEVEL>DEBUG</LOG-TRACE-DEFAULT-LOG-LEVEL>
                                            <LOG-TRACE-FILE-PATH>/var/redirected/</LOG-TRACE-FILE-PATH>
                                            <LOG-TRACE-LOG-MODES>
                                                <LOG-TRACE-LOG-MODE>CONSOLE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>FILE</LOG-TRACE-LOG-MODE>
                                                <LOG-TRACE-LOG-MODE>NETWORK</LOG-TRACE-LOG-MODE>
                                            </LOG-TRACE-LOG-MODES>
                                        </DLT-LOG-CHANNEL>
                                    </DLT-LOG-CHANNELS>
                                </LOG-AND-TRACE-INSTANTIATION>
                            </MODULE-INSTANTIATIONS>
                        </MACHINE>
                    </ELEMENTS>
                </AR-PACKAGE>
            </AR-PACKAGES>
        </AR-PACKAGE>
    </AR-PACKAGES>
</AUTOSAR>

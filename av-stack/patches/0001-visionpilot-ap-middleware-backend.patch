+# AUTOSAR Adaptive Platform (CAPI) middleware
+# Requires -DARA_GEN_OUTPUT=<dir with ara-gen output>; see
+# modules/middleware_interfaces/ap_interface/CMakeLists.txt
+option(ENABLE_AP_INTERFACE "Enable AUTOSAR Adaptive (CAPI) support" OFF)
